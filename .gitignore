# ===== 环境与敏感信息 =====
# 密钥只在本机 .env，仓库里只留模板
.env
*.env
!.env.example

# ===== Python =====
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ===== 前端 =====
node_modules/
dist/
build/

# ===== 任务产物（运行时数据）=====
