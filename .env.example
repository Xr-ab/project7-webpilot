# LLM：智谱 GLM（OpenAI 兼容协议）
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash

# Agent 运行上限（防死循环）
MAX_STEPS=12
TASK_TIMEOUT_SECONDS=180

# 域名白名单：只有这些 host 能被 Agent 访问
# 注意这里只放 host，不带协议和路径；端口不影响判断
# 本地测试站：127.0.0.1,localhost
# 真实站点（P2.5 走出测试站）：
#   books.toscrape.com / quotes.toscrape.com  静态电商与引语站，无反爬
#   developer.mozilla.org                     MDN，大型真实文档站（前端渲染）
ALLOWED_HOSTS=127.0.0.1,localhost,books.toscrape.com,quotes.toscrape.com,developer.mozilla.org

# 服务端口
APP_PORT=8000

# ---- 语音（P2）----
# 总开关。关掉后语音接口返回 503，前端麦克风按钮置灰
VOICE_ENABLED=true

# ASR（听）：faster-whisper 的模型名。small=464MB，中文短句够用
# 可选 tiny/base/small/medium。越往上越准也越慢越大
ASR_MODEL=small
# 固定 zh：短句做语言检测很容易判错（中文被认成日语是常见现象）
ASR_LANGUAGE=zh

# TTS（说）：微软音色名
# 女声标准 zh-CN-XiaoxiaoNeural / 男声 zh-CN-YunxiNeural / 播报腔 zh-CN-YunyangNeural
TTS_VOICE=zh-CN-XiaoxiaoNeural

# 上传录音体积上限（MB）
VOICE_MAX_MB=20

# ⚠️ HuggingFace 下载模型用（asr.py 里已有默认值，这里列出来是为了可覆盖）
# 国内必须走镜像；并且必须关掉 Xet，否则会 401（镜像不代理 Xet 存储）
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_XET=1

# ---- 存储（P3）----
# PostgreSQL 连接串（SQLAlchemy 格式，驱动用 asyncpg）
# 本地用 docker 起：见 P3-实施计划.md 里的 docker run 命令
# 有默认值，不填也能启动（M1 阶段业务还没依赖数据库）
# 端口 5433：本机 5432 已被另一个项目的 postgres 占用，各项目独立实例
DATABASE_URL=postgresql+asyncpg://webpilot:webpilot@127.0.0.1:5433/webpilot

# ---- 队列（P3-M3）----
# 端口 6380：避免和本机其它项目的 redis 撞车（同 DATABASE_URL 的 5433）
REDIS_URL=redis://127.0.0.1:6380/0
# 关掉就退回进程内执行（P1 的行为）。redis 连不上时也会自动降级，不用手动关
QUEUE_ENABLED=true
# 同时跑几个任务：免费档 LLM 有并发限制，每个 Chromium 吃 200~400MB
MAX_JOBS=3

# ---- 认证与隔离（P3-M4）----
# JWT 签名密钥。有默认值，本地不改也能跑；
# ⚠️ 任何对外部署必须换成随机长串——密钥泄露 = 任何人可伪造任意用户的 token。
JWT_SECRET=dev-secret-change-me
# 认证开关。默认开（验收要求：不带 token → 401）。
# 关掉后退回 P3-M3 行为：所有任务挂到占位用户 local@webpilot.dev 名下，不校验 token。
AUTH_ENABLED=true
# token 有效期（分钟）。480 ≈ 一个工作日，过期重新登录
TOKEN_EXPIRE_MINUTES=480
# 任务媒体（截图/语音）签名 URL 的有效期（秒）。
# 截图是 <img src> 加载的，带不了 Authorization 头，所以凭证放在 URL 里（HMAC 签名）。
# 过期不影响使用：刷新页面会重新拉 trace 并重新签名。
MEDIA_URL_TTL_SECONDS=3600

# ---- 浏览器代理（P2.5）----
# 留空 = 自动读 HTTP(S)_PROXY；填 direct = 强制直连（哪怕系统设了代理）
BROWSER_PROXY=

# ---- 审批停等（P5）----
# 高风险动作（提交、删除、支付…）是否需要人工批准。默认开（默认安全）
# ⚠️ 批处理脚本（eval_real / stress / collect_corpus）必须显式传 require_approval=false，
#    否则任务会永远卡在 waiting_approval
APPROVAL_ENABLED=true

# ---- 登录限流（P5）----
# 同一 email 连续失败几次后锁定，以及锁多久（秒）
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900

# ---- 视觉兜底（P6a）----
# 总开关，**默认关**。视觉会改 prompt，开着会让评测基线不可比，
# 所以默认关、只在演示/验收时打开
VISION_ENABLED=false
# 打开总开关后，是否按条件自动触发（元素稀少且有 canvas/大图、连续失败）
VISION_AUTO_FALLBACK=true
# 视觉模型。⚠️ 预检实测：glm-4.6v-flash 免费额度极紧（15/45/90s 退避全撞 429），
# 用 glm-4v-flash，别换回去
VISION_MODEL=glm-4v-flash
VISION_TRIGGER_MIN_ELEMENTS=3
VISION_TRIGGER_MAX_FAILURES=2

# ---- Docker Compose（P7-D3）----
# ⚠️ 用 docker compose 时，下面这两个地址会被 compose 自动覆盖成容器服务名
#    （pg:5432 / redis:6379），**不要在这里改**——上面那两行是"本机直接跑"用的。
#    容器里 127.0.0.1 指的是容器自己，写死 127.0.0.1:5433 会连不上任何东西。
#
# 容器模式下测试站地址不是 127.0.0.1:8000，而是：
#     http://api:8000/testsite/index.html
# compose 已经自动往 ALLOWED_HOSTS 末尾追加了 api，不用手动加。
# 语音任务的默认起始页同理由 compose 注入（DEFAULT_START_URL，见 docker-compose.yml）：
# start_url 最终是 worker 容器里的 Chromium 在导航，它的 127.0.0.1 不是 api。
#
# check_* 系列脚本在容器里跑的方式（scripts/ 已打进镜像）：
#     docker compose exec -e WEBPILOT_BASE=http://api:8000 api \
#         python /app/scripts/check_redact.py
# WEBPILOT_BASE 同时覆盖脚本里的 API 地址和浏览器 start_url——漏了它，
# API 调用通、Chromium 导航被拒，看起来像"半通"最迷惑。
